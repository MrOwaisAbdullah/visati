# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.agents
.claude
.specify
/docs/
CLAUDE.md
.mcp.json

# Deploy scratch artifacts (DB dumps, deploy zips, scripts with hardcoded
# server/DB credentials) — never commit a raw DB dump or a live credential.
wordpress/docs/*.sql
wordpress/docs/*.zip
wordpress/docs/dump-db.php
wordpress/docs/upload.php
wordpress/deploy-local.ps1
specs/
history/
screenshots/
skills-lock.json