    {
      "id": "hero-section",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "content_width": {"unit": "px", "size": 1200, "sizes": []},
        "padding": {"unit": "px", "top": "120", "right": "0", "bottom": "60", "left": "0", "isLinked": false},
        "background_background": "classic",
        "background_color": "#ffffff"
