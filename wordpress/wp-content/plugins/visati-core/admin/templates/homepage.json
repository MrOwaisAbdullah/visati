          },
          "elements": [
            {
              "id": "reach-widget",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div style=\"position:relative;border-radius:24px;background:#0a1a3a;overflow:hidden;min-height:380px;padding:48px;display:flex;align-items:center;justify-content:space-between;gap:64px;flex-wrap:wrap;\"><div style=\"position:absolute;inset:0;opacity:0.08;background:radial-gradient(circle at 60% 40%,#C9A84C 0%,transparent 60%);pointer-events:none;\"></div><div style=\"position:relative;z-index:1;max-width:480px;\"><p style=\"font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.12em;color:#C9A84C;margin:0 0 12px;\">Global Reach</p><h2 style=\"font-size:clamp(24px,3vw,34px);font-weight:700;color:#fff;margin:0 0 16px;line-height:1.2;\">Trusted by Applicants Across the Globe</h2><p style=\"font-size:14px;color:rgba(255,255,255,0.6);margin:0 0 24px;line-height:1.6;\">We are a Dubai based visa agency serving residents of all nationalities across USA, UK, Canada, Australia and Europe.</p><a href=\"/about\" style=\"display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:10px;border:1px solid rgba(201,168,76,0.25);background:rgba(201,168,76,0.1);color:#C9A84C;font-size:12px;font-weight:600;text-decoration:none;\">More About Us</a></div><div style=\"position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr;gap:20px;\"><div style=\"display:flex;align-items:center;gap:12px;\"><div style=\"width:36px;height:36px;border-radius:8px;background:rgba(255,255,255,0.06);display:grid;place-items:center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"rgba(201,168,76,0.6)\" stroke-width=\"1.5\"><path d=\"M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/></svg></div><div><p style=\"font-size:20px;font-weight:700;color:#fff;margin:0;\">1,000+</p><p style=\"font-size:11px;color:rgba(255,255,255,0.5);margin:2px 0 0;\">Happy Travelers</p></div></div><div style=\"display:flex;align-items:center;gap:12px;\"><div style=\"width:36px;height:36px;border-radius:8px;background:rgba(255,255,255,0.06);display:grid;place-items:center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"rgba(201,168,76,0.6)\" stroke-width=\"1.5\"><path d=\"M22 11.08V12a10 10 0 11-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg></div><div><p style=\"font-size:20px;font-weight:700;color:#fff;margin:0;\">99%</p><p style=\"font-size:11px;color:rgba(255,255,255,0.5);margin:2px 0 0;\">Approval Rate</p></div></div><div style=\"display:flex;align-items:center;gap:12px;\"><div style=\"width:36px;height:36px;border-radius:8px;background:rgba(255,255,255,0.06);display:grid;place-items:center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"rgba(201,168,76,0.6)\" stroke-width=\"1.5\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/></svg></div><div><p style=\"font-size:20px;font-weight:700;color:#fff;margin:0;\">100+</p><p style=\"font-size:11px;color:rgba(255,255,255,0.5);margin:2px 0 0;\">Google Reviews</p></div></div><div style=\"display:flex;align-items:center;gap:12px;\"><div style=\"width:36px;height:36px;border-radius:8px;background:rgba(255,255,255,0.06);display:grid;place-items:center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"rgba(201,168,76,0.6)\" stroke-width=\"1.5\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z\"/></svg></div><div><p style=\"font-size:20px;font-weight:700;color:#fff;margin:0;\">4.9/5</p><p style=\"font-size:11px;color:rgba(255,255,255,0.5);margin:2px 0 0;\">Customer Rating</p></div></div></div></div>"
              }
